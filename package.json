{
  "name": "rudiment-ui",
  "version": "0.3.0",
  "description": "Accessible React component library built on React Aria, with layout primitives, charts, and a three-tier design token architecture supporting eight built-in themes.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "prepare": "npm run build:tokens && npm run build",
    "prepublishOnly": "npm run build:tokens && npm run build",
    "build-storybook": "storybook build",
    "build:tokens": "style-dictionary build --config tokens/style-dictionary.config.mjs && style-dictionary build --config tokens/style-dictionary.config.dark.mjs && style-dictionary build --config tokens/style-dictionary.config.roomy.mjs && style-dictionary build --config tokens/style-dictionary.config.roomy-dark.mjs && style-dictionary build --config tokens/style-dictionary.config.soft.mjs && style-dictionary build --config tokens/style-dictionary.config.soft-dark.mjs && style-dictionary build --config tokens/style-dictionary.config.compressed.mjs && style-dictionary build --config tokens/style-dictionary.config.compressed-dark.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rudiment-UI/rudiment-ui.git"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "react-aria",
    "accessibility",
    "a11y",
    "design-tokens",
    "ui-components",
    "layout-primitives",
    "theming"
  ],
  "author": "Joshua Briley",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Rudiment-UI/rudiment-ui/issues"
  },
  "homepage": "https://github.com/Rudiment-UI/rudiment-ui#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@react-aria/utils": "^3.33.1",
    "clsx": "^2.1.1",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-stately": "^3.45.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.0",
    "playwright": "^1.58.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.2.19",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0",
    "vitest-axe": "^0.1.0"
  }
}
