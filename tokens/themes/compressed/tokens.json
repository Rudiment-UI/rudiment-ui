    },
    "checkbox": {
      "control-border": { "$value": "transparent", "$type": "color" },
      "checked-border": { "$value": "transparent", "$type": "color" }
    },
    "radio": {
      "control-border": { "$value": "transparent", "$type": "color" },
      "selected-border": { "$value": "transparent", "$type": "color" }
    },
    "tag": {
      "default-border": { "$value": "transparent", "$type": "color" },
      "success-border": { "$value": "transparent", "$type": "color" },
      "warning-border": { "$value": "transparent", "$type": "color" },
      "error-border": { "$value": "transparent", "$type": "color" },
      "info-border": { "$value": "transparent", "$type": "color" }
    },
    "card": {
      "padding-sm": { "$value": "{spacing.1}" },
      "padding-md": { "$value": "{spacing.2}" },
      "padding-lg": { "$value": "{spacing.3}" },
      "border": { "$value": "transparent", "$type": "color" },
      "header-border": { "$value": "transparent", "$type": "color" },
      "footer-border": { "$value": "transparent", "$type": "color" }
    },
    "chart": {
      "tooltip-border": { "$value": "transparent", "$type": "color" }
    },
    "alert": {
      "info-border": { "$value": "transparent", "$type": "color" },
      "success-border": { "$value": "transparent", "$type": "color" },
      "warning-border": { "$value": "transparent", "$type": "color" },
      "error-border": { "$value": "transparent", "$type": "color" }
    },
    "menu": {
      "popover-border": { "$value": "transparent", "$type": "color" }
    },
    "kanban": {
      "card-border": { "$value": "transparent", "$type": "color" }
    }
  },
  "typography": {
    "prose": {
      "blockquote-border": { "$value": "transparent", "$type": "color" },
      "pre-border": { "$value": "transparent", "$type": "color" },
      "table-border": { "$value": "transparent", "$type": "color" }
    }
  },
  "layout": {
    "stack": {
      "space": {
        "default": { "$value": "{spacing.2}" },
        "dense": { "$value": "{spacing.1}" },
        "loose": { "$value": "{spacing.4}" }
      }
    },
    "grid": {
      "space": { "$value": "{spacing.2}" }
    },
    "cluster": {
      "space": { "$value": "{spacing.2}" }
