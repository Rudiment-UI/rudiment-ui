{
  "spacing": {
    "0": { "$value": "0", "$type": "dimension" },
    "1": { "$value": "0.0625rem", "$type": "dimension" },
    "2": { "$value": "0.09375rem", "$type": "dimension" },
    "3": { "$value": "0.125rem", "$type": "dimension" },
    "4": { "$value": "0.1875rem", "$type": "dimension" },
    "6": { "$value": "0.25rem", "$type": "dimension" },
    "8": { "$value": "0.3125rem", "$type": "dimension" },
    "12": { "$value": "0.4375rem", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0", "$type": "dimension" },
    "sm": { "$value": "0", "$type": "dimension" },
    "md": { "$value": "0", "$type": "dimension" },
    "lg": { "$value": "0.0625rem", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "component": {
    "button": {
      "secondary-border": { "$value": "transparent", "$type": "color" }
    },
