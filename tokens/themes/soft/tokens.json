{
  "color": {
    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "50":  { "$value": "#FAF8F6", "$type": "color" },
      "100": { "$value": "#F4F1EC", "$type": "color" },
      "200": { "$value": "#E9E3DB", "$type": "color" },
      "300": { "$value": "#D7CFC4", "$type": "color" },
      "400": { "$value": "#A89F92", "$type": "color" },
      "500": { "$value": "#7C7367", "$type": "color" },
      "600": { "$value": "#5A5249", "$type": "color" },
      "700": { "$value": "#423B33", "$type": "color" },
      "800": { "$value": "#2A2620", "$type": "color" },
      "900": { "$value": "#1C1813", "$type": "color" }
    },
    "soft": {
      "50":  { "$value": "#F2F1FB", "$type": "color" },
      "100": { "$value": "#E6E4F6", "$type": "color" },
      "200": { "$value": "#CFCBEC", "$type": "color" },
      "300": { "$value": "#B0AADF", "$type": "color" },
      "400": { "$value": "#8E86CE", "$type": "color" },
      "500": { "$value": "#7169BC", "$type": "color" },
      "600": { "$value": "#5B54A3", "$type": "color" },
      "700": { "$value": "#4A4488", "$type": "color" },
      "800": { "$value": "#3A356B", "$type": "color" },
      "900": { "$value": "#2B2850", "$type": "color" }
    }
  },
  "radius": {
    "none": { "$value": "0", "$type": "dimension" },
    "sm": { "$value": "0.5rem", "$type": "dimension" },
    "md": { "$value": "0.875rem", "$type": "dimension" },
    "lg": { "$value": "1.25rem", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "font": {
    "family": {
      "sans": { "$value": "'Nunito', ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" }
    }
  }
}
