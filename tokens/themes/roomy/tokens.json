    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "50":  { "$value": "#FAFAF8", "$type": "color" },
      "100": { "$value": "#F3F2EF", "$type": "color" },
      "200": { "$value": "#E6E4DE", "$type": "color" },
      "300": { "$value": "#D3CFC7", "$type": "color" },
      "400": { "$value": "#9F988D", "$type": "color" },
      "500": { "$value": "#726B61", "$type": "color" },
      "600": { "$value": "#524B42", "$type": "color" },
      "700": { "$value": "#3C362E", "$type": "color" },
      "800": { "$value": "#26221C", "$type": "color" },
      "900": { "$value": "#1A1610", "$type": "color" }
    },
    "roomy": {
      "50":  { "$value": "#F0F2F7", "$type": "color" },
      "100": { "$value": "#E1E5EF", "$type": "color" },
      "200": { "$value": "#C7CEDE", "$type": "color" },
      "300": { "$value": "#A3AEC7", "$type": "color" },
      "400": { "$value": "#7080A3", "$type": "color" },
      "500": { "$value": "#556689", "$type": "color" },
      "600": { "$value": "#44536F", "$type": "color" },
      "700": { "$value": "#38455D", "$type": "color" },
      "800": { "$value": "#2C3547", "$type": "color" },
      "900": { "$value": "#202634", "$type": "color" }
    }
  },
  "spacing": {
    "0": { "$value": "0", "$type": "dimension" },
    "1": { "$value": "0.375rem", "$type": "dimension" },
    "2": { "$value": "0.75rem", "$type": "dimension" },
    "3": { "$value": "1.125rem", "$type": "dimension" },
    "4": { "$value": "1.5rem", "$type": "dimension" },
    "6": { "$value": "2.25rem", "$type": "dimension" },
    "8": { "$value": "3rem", "$type": "dimension" },
    "12": { "$value": "4.5rem", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0", "$type": "dimension" },
    "sm": { "$value": "0.25rem", "$type": "dimension" },
    "md": { "$value": "0.5rem", "$type": "dimension" },
    "lg": { "$value": "0.75rem", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "font": {
    "family": {
      "sans": { "$value": "'Rubik', ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" }
    }
  }
}
